{
  "name": "dependency-graph",
  "version": "0.1.0",
  "description": "Dependency Graph — codebase dependency graph: MCP server, incremental multi-language indexer, and visual dashboard",
  "keywords": [
    "code-graph",
    "dependency-graph",
    "mcp",
    "static-analysis",
    "typescript"
  ],
  "bin": {
    "dependency-graph": "./dist/cli.js",
    "dependency-graph-mcp": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@modelcontextprotocol/sdk": "^1.20.0",
    "hono": "^4.9.6",
    "typescript": "^5.9.2",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@dependency-graph/analyzer-typescript": "workspace:*",
    "@dependency-graph/graph-core": "workspace:*",
    "@dependency-graph/indexer": "workspace:*",
    "@dependency-graph/mcp-server": "workspace:*"
  },
  "engines": {
    "node": ">=23.4.0"
  }
}
